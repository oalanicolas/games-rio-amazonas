{
  "headers": [
    { "source": "/sw.js$", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/stats.js$", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(marca|geografia|fonts|audio)/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
