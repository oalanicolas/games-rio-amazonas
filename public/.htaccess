Options -Indexes
AddDefaultCharset utf-8
AddType text/javascript .js .mjs
AddType audio/ogg .ogg
AddType font/woff2 .woff2
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always merge Vary "User-Agent"
  Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} == 403"
  SetEnvIf Request_URI "^/assets/" VERSIONED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=VERSIONED_ASSET
  SetEnvIf Request_URI "^/(sw\.js|stats\.js|marca/|geografia/|fonts/|audio/)" REVALIDATE
  Header set Cache-Control "no-cache" env=REVALIDATE
  <FilesMatch "\.(html|json|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
